# Toastly — environment variables
#
# Copy to .env.local and fill in. Grouped by when you actually need them:
# nothing here is required to run the public marketing site.
#
#   npm run dev      -> works with an empty file (marketing pages only)
#   sign-in / app    -> needs REQUIRED NOW
#   each feature     -> needs its own block below
#
# .env.local is gitignored. Never commit real values.

# ---------------------------------------------------------------------------
# REQUIRED NOW — for anything behind sign-in
# ---------------------------------------------------------------------------
# Without these, /login, /verify, /profile, /feed, /inbox and /wallet show a
# "Supabase isn't configured" notice instead of working. The marketing pages
# are unaffected.
#
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security, so it must NEVER be exposed
# to the browser and must never be given the NEXT_PUBLIC_ prefix. Needed for
# staff tooling (the integrity review queue, report triage).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# REQUIRED BEFORE PRODUCTION
# ---------------------------------------------------------------------------
# Your canonical origin, no trailing slash. Every canonical URL, Open Graph
# image URL and sitemap entry is built from this; the default is a guess
# (https://trytoastly.com) and will be wrong in search results if left unset.
NEXT_PUBLIC_SITE_URL=

# Secret salt for phone-number hashing. Phone numbers are stored only as
# hashes, and the phone-number space is small enough to brute-force, so an
# unpeppered hash is effectively reversible. Verification REFUSES TO RUN in
# production without this. Generate once, never rotate casually — changing it
# invalidates every existing phone identity:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_HASH_PEPPER=

# ---------------------------------------------------------------------------
# GIST SESSIONS — voice and video calling
# ---------------------------------------------------------------------------
# LiveKit is the one WebRTC provider (CLAUDE.md: pick one, stay on it).
# Without these, a Gist session page says calling isn't connected; the
# session flow, question deck and entitlement caps still work.
# One scheme only: wss://<project>.livekit.cloud  (not wss://wss://...).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# PAYMENTS — two providers, never crossed
# ---------------------------------------------------------------------------
# Paystack handles NGN only; Stripe handles USD only. The payments table has
# a CHECK constraint refusing any other pairing.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

STRIPE_SECRET_KEY=
# Used to verify webhook signatures. Distinct from the secret key above.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# DATE-SPOT SUGGESTION — public-venue lookup
# ---------------------------------------------------------------------------
# One maps provider (PRD §5.5: a lookup, never a curated venue directory).
# Server-side only — never NEXT_PUBLIC_, since a browser-visible maps key is
# billable by anyone who finds it.
#
# Without it, two people who both said "continue" are told suggestions
# aren't connected yet and can still arrange the date themselves. Nothing
# else in the Gist or stake flow changes.
#
# Google Cloud console -> APIs & Services -> Credentials. Enable "Places API
# (New)" and restrict the key to it.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# TRANSACTIONAL EMAIL — Resend
# ---------------------------------------------------------------------------
# Carries receipts, the re-verification notice (PRD 5.1.1) and the
# emergency-contact security notice. Without it those silently don't send;
# nothing else changes.
#
# NOTE: account verification codes are NOT sent from here. Supabase Auth
# sends the phone OTP and the email confirmation. Adding a second code system
# would mean two sources of truth for one account.
RESEND_API_KEY=
# Must be a verified sender domain in Resend.
EMAIL_FROM=Toastly <hello@trytoastly.com>

# ---------------------------------------------------------------------------
# SMS — emergency contact confirmation and panic alerts ONLY
# ---------------------------------------------------------------------------
# Never the call path. Calling is VoIP through the app and neither member's
# real number is ever routed or exposed (CLAUDE.md); a constraint check fails
# if this is imported by Gist or LiveKit code.
#
# Termii carries +234, Twilio carries everything else.
TERMII_API_KEY=
# Registered alphanumeric sender ID (Termii approves this before it works).
TERMII_SENDER_ID=Toastly

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sending number, in E.164.
TWILIO_FROM_NUMBER=

# Verification codes (sign-in, new device, phone change, account deletion).
# Supabase makes the code and calls the Send SMS hook (app/api/auth/send-sms);
# lib/sms-codes.ts delivers it. +234 goes through Termii (TERMII_API_KEY above,
# channel "dnd") under its OWN approved sender ID below; TERMII_SENDER_ID above
# stays for the emergency and on-call texts and is not used for codes.
# Set these in Vercel PRODUCTION only,
# never Preview: only the production deploy sends a real SMS, and local and
# Preview log "code sent" and send nothing.
#
# Generated by Supabase when the hook is created (Authentication -> Hooks ->
# Send SMS -> Generate secret); paste the whole "v1,whsec_..." string.
TERMII_CODE_SENDER_ID=OE Alert
SEND_SMS_HOOK_SECRET=
# Set to true the moment the hook is switched on in Supabase. Until then the
# phone step behaves as before; after it, only +234 numbers can be sent a code.
SMS_CODES_VIA_HOOK=

# The founding-members beta (migration 0050, lib/beta.ts). Set to true in
# Vercel PRODUCTION to make sign-up invite-only: a number that isn't an approved
# application is told "Toastly is invite-only for now. Apply at
# trytoastly.com/beta." and sent no code (the phone step asks first, and the
# Send SMS hook asks again). Leave it unset locally and in Preview. Switch it
# off when Toastly opens to everyone. Uses PHONE_HASH_PEPPER (above) to look a
# number up; without it, nothing is sent.
BETA_INVITE_ONLY=

# ---------------------------------------------------------------------------
# ANALYTICS — PostHog
# ---------------------------------------------------------------------------
# Five product events only: signup, verification complete, first Gist, first
# deposit, upgrade. Trust Sentinel events are NOT sent here — Supabase is
# their system of record, because they feed an auditable human review queue.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---------------------------------------------------------------------------
# IDENTITY — Smile ID (liveness + NIN/BVN)
# ---------------------------------------------------------------------------
# Hosted web integration (v12). SERVER ONLY — never NEXT_PUBLIC_. The API key
# mints per-session tokens and checks the callback signature; the browser
# never sees it. Without all four, verification answers 503.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
# "sandbox" or "production".
SMILE_ID_ENV=sandbox
# Must be the host production serves (www — the bare domain redirects, and a
# redirected webhook is dropped).
SMILE_ID_CALLBACK_URL=https://www.trytoastly.com/api/smile-id/callback
# Sandbox only: comma-separated emails allowed to use the test-identity picker
# on a Vercel production deployment. Leave empty everywhere else.
SMILE_ID_SANDBOX_TESTERS=
# Offer Virtual NIN in the ID check. Leave unset until Smile ID enables the
# V_NIN ID type for our account; then set to true (no code change).
SMILE_ID_VNIN_ENABLED=

# ---------------------------------------------------------------------------
# AI — Claude API (Toastly Help and Answer Mirror, PRD §5.9)
# ---------------------------------------------------------------------------
# SERVER ONLY. Both launch agents run on Claude Haiku through stateless
# calls (lib/ai/client.ts). Without it, Answer Mirror's button is hidden and
# Toastly Help answers with an offer to pass the question to a person.
ANTHROPIC_API_KEY=
# Where Toastly Help hand-off notices go (reference and category only).
SUPPORT_INBOX=support@trytoastly.com

# ---------------------------------------------------------------------------
# NOT YET USED — listed because CLAUDE.md fixes the stack
# ---------------------------------------------------------------------------
# Nothing reads this yet. It is here so the choice stays recorded.

# --- Launch switch (lib/launch.ts; decided 8 October 2026) -------------------
# Off unless exactly "true": no plan screen, checkout or coin purchase can
# complete for anyone except staff and the emails below. Launch day = set this
# to true in Vercel Production and redeploy. Server only.
LAUNCH_PAYMENTS_ENABLED=false
# Comma-separated emails that can pay before launch (test accounts).
LAUNCH_TEST_ACCOUNTS=
