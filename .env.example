# Supabase — required for the app to boot
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments — Paystack for NGN (domestic), Stripe for USD (diaspora).
# Kept separate per PRD §7 pricing-integrity / anti-arbitrage requirements.
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=

# Claude API — tiered model selection (Haiku cheap/high-volume, Sonnet general,
# Opus only where genuinely needed). Do not default to the most expensive model.
ANTHROPIC_API_KEY=

# Realtime voice/video for Gist. Pick ONE provider and stay on it.
# VoIP only — never route through a carrier number or expose a real phone number.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# WhatsApp Business Cloud API — notifications, not an in-app chat replacement
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Analytics / email
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
RESEND_API_KEY=
